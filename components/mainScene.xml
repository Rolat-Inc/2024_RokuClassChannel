<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
	<interface>
		<field id="videoMessage" type="assocarray" alias="videoPlayer.incomingMessage" />
	</interface>

	<script type="text/brightscript" uri="mainScene.brs" />

	<children>
		<LayoutGroup
			layoutDirection="vert"
			itemSpacings="[20]">

			<Overhang
				showClock="true"
				logoUri="pkg:/images/rolat-logo-blanco.png" />

			<LayoutGroup
				layoutDirection="horiz"
				itemSpacings="[20,100]"
				addItemSpacingAfterChild="false">

				<SideBar id="sideBar"/>
				<NavigationHandler id="navigationHanlder"/>
			</LayoutGroup>
		</LayoutGroup>

		<VideoPlayer
			id="videoPlayer"/>
	</children>
</component>
