<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
	<interface>
		<field id="deepLink" type="assocarray" onChange="onDeepLinkChanged" /> 
		<field id="videoMessage" type="assocarray" alias="videoPlayer.incomingMessage" />
		<function name="unmuteMainScene"/>
		<function name="handleTransport"/>
	</interface>

	<customization suspendhandler="customSuspend" />
	<customization resumehandler="customResume" />

	<script type="text/brightscript" uri="mainScene.brs" />
	<script type="text/brightscript" uri="voiceControl.brs" />
	<script type="text/brightscript" uri="rokuPayHandler.brs" />
	<script type="text/brightscript" uri="deepLinkHelper.brs" />
	<script type="text/brightscript" uri="instantResumeHelper.brs" />

	<script type="text/brightscript" uri="../functions/utils.brs" />

	<children>
		<LayoutGroup
			layoutDirection="vert"
			itemSpacings="[20]">

			<Overhang
				showClock="true"
				logoUri="pkg:/images/rolat-logo-blanco.png" />

			<LayoutGroup
				layoutDirection="horiz"
				itemSpacings="[20,100]"
				addItemSpacingAfterChild="false">

				<SideBar id="sideBar"/>
				<NavigationHandler id="navigationHanlder"/>
			</LayoutGroup>
		</LayoutGroup>

		<VideoPlayer
			id="videoPlayer"
			visible="false"/>
	</children>
</component>
