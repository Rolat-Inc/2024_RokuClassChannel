<?xml version="1.0" encoding="utf-8" ?>
<component name="VideoPlayer" extends="Video">
	<interface>
		<field id="incomingMessage" type="assocarray" onChange="onIncomingMessageChanged" />
	</interface>

	<script type="text/brightscript" uri="videoPlayer.brs" />

	<children>
		<Rectangle
			width="100"
			height="50"
			color="0x000000"
			opacity="0.7"
			translation="[910,890]">

			<FontLabel
				id="speedMultiplierLabel"
				uri="pkg:/fonts/Black.ttf"
				size="40"/>
		</Rectangle>

		<Timer
			id="counterTimer"
			duration="1"
			repeat="true"/>
	</children>
</component>