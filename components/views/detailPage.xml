<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailPage" extends="BaseView">
	<script type="text/brightscript" uri="detailPage.brs" />

	<children>
		<LayoutGroup
			layoutDirection = "vert"
			itemSpacings = "[20,15]"
			vertAlignment = "center">
			
			<Poster
				id = "contentImage"
				height = "600"
				width = "350">
				
				<Poster
					id = "playIcon"
					uri = "https://cdn-icons-png.flaticon.com/512/4340/4340129.png"
					width = "100"
					height = "100" />
			</Poster>

			<Label
				id = "contentTitle"
				font = "font:MediumBoldSystemFont"  />

			<Label
				id = "contentDescription"
				font = "font:SmallSystemFont"
				width = "1500"
				maxLines = "3"
				wrap = "true" />
		</LayoutGroup>
	</children>
</component>