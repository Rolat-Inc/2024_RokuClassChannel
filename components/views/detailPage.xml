<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailPage" extends="BaseView">
	<script type="text/brightscript" uri="detailPage.brs" />

	<children>
		<LayoutGroup
			layoutDirection = "vert"
			itemSpacings = "[30]"
			horizAlignment = "center"
        	vertAlignment = "top">
			
			<Poster
				id = "contentImage"
				width = "654"
				height = "516">
				
				<Poster
					id = "playIcon"
					uri = "https://clipart-library.com/images/6Tp5aga7c.png"
					width = "100"
					height = "100"
					blendColor = "0xFFFFFF" />
			</Poster>

			<Label
				id = "contentTitle"
				font = "font:MediumBoldSystemFont"  />

			<Label
				id = "contentDescription"
				font = "font:SmallestSystemFont"
				width = "1500"
				maxLines = "3"
				wrap = "true"
				horizAlign = "center" />
		</LayoutGroup>
	</children>
</component>