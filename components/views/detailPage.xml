<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailPage" extends="BaseView">
	<script type="text/brightscript" uri="detailPage.brs" />

	<children>
		<Poster
			id="background"
			uri="pkg:/images/background.jpeg"
			width="1920"
			height="1080" />

		<LayoutGroup
			layoutDirection="horiz"
			itemSpacings="[40]"
			translation="[100, 100]">

			<Poster
				id="image" />
				
			<LayoutGroup
				layoutDirection="vert"
				itemSpacings="[15, 15, 20]">
				
				<Label
					id="title"
					font="font:ExtraLargeBoldSystemFont" />

				<LayoutGroup
					layoutDirection="horiz"
					itemSpacings="[15]">
						<Badge
							id="network"
							font="font:TinyBoldSystemFont" />
						
						<Badge
							id="rating"
							font="font:TinyBoldSystemFont" />
				</LayoutGroup>

				<Label
					id="genres"
					font="font:TinySystemFont" />

				<Button
					id="playButton"
					color="0x5f9ea0"
					iconUri="pkg:/images/playIcon.png"
					text="Play"/>
			
				<Label
					id="description"
					font="font:SmallestSystemFont"
					width="1000"
					maxLines="3"
					wrap="true"
					horizAlign="center" />
			</LayoutGroup>
		</LayoutGroup>
	</children>
</component>