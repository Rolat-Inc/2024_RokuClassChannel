<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchView" extends="BaseView">
        <script type="text/brightscript" uri="searchView.brs" />

        <children>
            <LayoutGroup
                layoutDirection="horiz"
                itemSpacings="[20]">
            
                <LayoutGroup
                    layoutDirection="vert"
                    itemSpacings="[10]">
                    
                    <MiniKeyboard
                        id="miniKeyboard"/>

                    <Button
                        id="button"
                        text="Save" />
                </LayoutGroup>

                <RowList 
                    id = "resultsRowList"
                    numRows = "4"
                    itemSize = "[ 1067, 300 ]"
                    rowItemSize = "[ [330, 250] ]"
                    itemSpacing = "[ 0, 40 ]" 
                    rowItemSpacing = "[20, 20]"
                    showRowLabel = "[ true ]"
                    showRowCounter = "[ true ]"
                    focusBitmapUri = "pkg:/images/focus_grid.9.png"
                    vertFocusAnimationStyle = "fixedFocusWrap" 
                    rowFocusAnimationStyle = "fixedFocus" />
            </LayoutGroup>
        </children>
</component>