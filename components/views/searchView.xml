<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchView" extends="BaseView">
        <script type="text/brightscript" uri="searchView.brs" />

        <children>
            <LayoutGroup
                layoutDirection="horiz"
                itemSpacings="[20]">
            
                <LayoutGroup
                    layoutDirection="vert"
                    itemSpacings="[10]">
                    
                    <MiniKeyboard
                        id="miniKeyboard"/>

                    <Button
                        id="button"
                        text="Save" />
                </LayoutGroup>

                <RowList
                    id = "resultsRowList"
                    itemComponentName = "ResultsItem"
                    numRows = "4"
                    itemSize = "[1070,400]"
                    rowItemSize = "[[327, 458]]"
                    rowItemSpacing = "[[40,0]]"
                    drawFocusFeedback = "false"
                    showRowLabel = "[true]"
                    showRowCounter = "[true]"
                    vertFocusAnimationStyle = "fixedFocusWrap" 
                    rowFocusAnimationStyle = "fixedFocus" />
            </LayoutGroup>
        </children>
</component>